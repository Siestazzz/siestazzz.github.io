$ink = #414268
$deep = #34365e
$cyan = #62dfd2
$pink = #ff6e9d
$yellow = #ffd34f
$paper = #f7f7fb

* { box-sizing: border-box; }
html { min-height: 100%; background: #c9d6e5; }
body { margin: 0; min-height: 100vh; color: $ink; font-family: "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif; background: #c9d6e5; }
a { color: inherit; text-decoration: none; }
button, input { font: inherit; }

.world-backdrop { position: fixed; inset: 0; overflow: hidden; z-index: 0; background: linear-gradient(155deg, #8bd7e6 0%, #dcd6e8 44%, #f0c8c2 100%); }
.world-backdrop:after { content: ""; position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(52,54,94,.22) 1px, transparent 1.35px); background-size: 5px 5px; opacity: .34; mix-blend-mode: multiply; }
.sky-shape { position: absolute; border-radius: 50%; filter: blur(1px); opacity: .28; }
.sky-shape-a { width: 560px; height: 220px; background: #fff; left: -80px; top: 8%; transform: rotate(-8deg); }
.sky-shape-b { width: 420px; height: 170px; background: #ffd6df; right: 4%; top: 18%; transform: rotate(14deg); }
.city { position: absolute; left: -3%; right: -3%; bottom: 0; background-repeat: repeat-x; filter: blur(2px); }
.city-back { height: 54%; opacity: .28; background-image: linear-gradient(90deg, transparent 0 3%, #64769b 3% 10%, transparent 10% 13%, #7589aa 13% 21%, transparent 21% 23%, #5e749a 23% 31%, transparent 31% 35%, #7183a2 35% 43%, transparent 43% 47%, #596e91 47% 55%, transparent 55% 60%, #768eaa 60% 70%, transparent 70% 73%, #627796 73% 84%, transparent 84% 88%, #7384a2 88% 97%, transparent 97%); clip-path: polygon(0 36%, 7% 36%, 7% 10%, 14% 10%, 14% 27%, 21% 27%, 21% 0, 28% 0, 28% 35%, 38% 35%, 38% 18%, 45% 18%, 45% 31%, 58% 31%, 58% 6%, 67% 6%, 67% 28%, 78% 28%, 78% 12%, 86% 12%, 86% 35%, 100% 35%, 100% 100%, 0 100%); }
.city-front { height: 31%; opacity: .22; background: repeating-linear-gradient(90deg, #5f5775 0 90px, #80738b 90px 180px, #b27983 180px 260px); clip-path: polygon(0 18%, 8% 18%, 8% 2%, 16% 2%, 16% 25%, 28% 25%, 28% 9%, 39% 9%, 39% 32%, 52% 32%, 52% 0, 63% 0, 63% 22%, 75% 22%, 75% 8%, 87% 8%, 87% 26%, 100% 26%, 100% 100%, 0 100%); }

.topbar { position: fixed; z-index: 30; top: 0; left: 0; right: 0; height: 86px; display: flex; align-items: center; justify-content: space-between; padding: 18px 28px; pointer-events: none; }
.site-chip, .topbar__right, .round-button { pointer-events: auto; }
.site-chip { display: flex; align-items: center; gap: 10px; font-weight: 900; color: #fff; text-shadow: 0 2px 4px rgba(52,54,94,.45); }
.site-chip__mark { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: $cyan; color: $deep; border: 4px solid #fff; text-shadow: none; box-shadow: 0 5px 14px rgba(52,54,94,.22); }
.topbar__right { display: flex; align-items: center; gap: 12px; }
.status-chip { padding: 8px 14px; border-radius: 18px; color: #fff; background: rgba(52,54,94,.85); font-size: 12px; font-weight: 900; box-shadow: 0 4px 12px rgba(52,54,94,.2); }
.status-chip i { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: $cyan; box-shadow: 0 0 0 3px rgba(98,223,210,.2); }
.round-button { width: 52px; height: 52px; display: grid; align-content: center; gap: 5px; padding: 0 13px; border: 0; border-radius: 50%; background: #fff; color: $ink; box-shadow: 0 5px 16px rgba(52,54,94,.22); cursor: pointer; }
.round-button span { height: 4px; border-radius: 4px; background: currentColor; }

.menu-panel { position: fixed; z-index: 60; top: 0; right: 0; bottom: 0; width: 92vw; max-width: 430px; padding: 26px; background: rgba(55,56,96,.96); color: #fff; transform: translateX(105%); transition: transform .25s ease; box-shadow: -12px 0 40px rgba(29,30,59,.28); }
.menu-panel__head { display: flex; justify-content: space-between; align-items: center; padding: 4px 4px 28px; font-weight: 900; letter-spacing: .12em; }
.menu-close { border: 0; background: transparent; color: #fff; font-size: 38px; cursor: pointer; }
.menu-panel nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.menu-panel nav a { min-height: 105px; padding: 16px; display: flex; gap: 13px; align-items: flex-start; border-radius: 12px; color: $ink; background: $paper; border: 2px solid rgba(255,255,255,.2); box-shadow: 0 5px 0 #232544; transition: transform .15s ease, background .15s ease; }
.menu-panel nav a:hover { transform: translateY(-3px); background: #fff; }
.menu-panel nav b { color: $pink; }
.menu-panel nav span { font-weight: 900; }
.menu-panel nav small { display: block; margin-top: 6px; font-size: 10px; color: #777896; }
.menu-scrim { position: fixed; z-index: 50; inset: 0; visibility: hidden; opacity: 0; background: rgba(32,33,59,.42); transition: .25s ease; }
.menu-open .menu-panel { transform: translateX(0); }
.menu-open .menu-scrim { visibility: visible; opacity: 1; }

.site-main { position: relative; z-index: 1; min-height: 100vh; }
.home-shell { min-height: 100vh; display: grid; grid-template-columns: minmax(280px, .85fr) minmax(620px, 1.5fr); align-items: center; gap: 4vw; padding: 100px 5vw 34px; overflow: hidden; }
.home-intro { color: #fff; text-shadow: 0 3px 12px rgba(52,54,94,.35); }
.eyebrow { font-weight: 900; letter-spacing: .13em; font-size: 12px; }
.home-intro h1 { margin: 12px 0 2px; color: #fff; font-size: clamp(72px, 9vw, 140px); line-height: .72; letter-spacing: -.07em; font-style: italic; font-weight: 300; }
.home-intro h1 span { padding-left: .36em; }
.ribbon { display: inline-flex; align-items: center; gap: 12px; margin: 24px 0 14px; padding: 10px 48px 10px 10px; color: $deep; font-weight: 900; background: $yellow; clip-path: polygon(0 0, 100% 0, 86% 50%, 100% 100%, 0 100%); text-shadow: none; }
.ribbon span { padding: 4px 8px; background: $deep; color: #fff; }
.home-intro__copy { max-width: 360px; line-height: 1.7; }
.play-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; padding: 9px 15px; border-radius: 22px; background: $deep; font-weight: 800; text-shadow: none; box-shadow: 0 5px 0 rgba(32,33,59,.4); }
.play-link span { display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; background: #fff; color: $deep; }

.device-wrap { transform: rotate(2.2deg); transform-origin: 60% 50%; }
.device { position: relative; padding: 27px 20px 22px; border-radius: 72px 72px 40px 40px; background: $deep; border: 5px solid #54568a; box-shadow: 0 25px 55px rgba(43,44,77,.42), inset 0 0 0 3px #9294bd; }
.device__speaker { position: absolute; z-index: 2; width: 28%; height: 26px; top: 0; left: 36%; border-radius: 0 0 14px 14px; background: $deep; }
.device__screen { min-height: 690px; padding: 58px 28px 25px; border-radius: 46px 46px 25px 25px; background: rgba(100,101,143,.82); background-image: radial-gradient(circle, rgba(255,255,255,.11) 1px, transparent 1.4px); background-size: 5px 5px; color: #fff; overflow: hidden; }
.screen-heading { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
.screen-heading .signal { font-size: 30px; }
.screen-heading div { display: flex; flex-direction: column; }
.screen-heading small { font-size: 10px; font-weight: 800; opacity: .7; letter-spacing: .15em; }
.screen-heading strong { font-size: 23px; }
.screen-heading > a { margin-left: auto; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: #fff; color: $ink; font-size: 26px; }
.record-list { display: grid; gap: 11px; }
.record-card { min-height: 119px; display: grid; grid-template-columns: 54px 1fr 32px; gap: 12px; align-items: center; padding: 13px 15px; color: $ink; border-radius: 15px; background: rgba(248,248,252,.92); box-shadow: 0 5px 0 rgba(35,37,68,.65); overflow: hidden; transition: transform .16s ease, background .16s ease; }
.record-card:hover { transform: translateX(-6px); background: #fff; }
.record-card__index { display: grid; place-items: center; width: 45px; height: 45px; border-radius: 50%; color: $deep; background: var(--accent); font-weight: 900; }
.record-card__body { min-width: 0; display: grid; gap: 3px; }
.record-card__body small { font-size: 10px; font-weight: 800; opacity: .68; }
.record-card__body strong { font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.record-card__body em { font-size: 11px; font-style: normal; opacity: .72; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.record-card__arrow { font-size: 36px; font-weight: 300; }
.quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 18px; }
.quick-grid a { display: grid; grid-template-columns: 36px 1fr; column-gap: 5px; align-items: center; min-height: 75px; padding: 10px; border-radius: 12px; color: $ink; background: rgba(248,248,252,.86); box-shadow: 0 4px 0 rgba(35,37,68,.55); }
.quick-grid span { grid-row: 1 / 3; font-size: 27px; }
.quick-grid b { align-self: end; }
.quick-grid small { align-self: start; font-size: 8px; opacity: .65; }

.accent-cyan { --accent: $cyan; }
.accent-pink { --accent: $pink; }
.accent-yellow { --accent: $yellow; }

.reader-shell { width: calc(100% - 44px); max-width: 1180px; margin: 0 auto; padding: 130px 0 70px; display: grid; grid-template-columns: 230px minmax(0, 820px); justify-content: center; gap: 26px; }
.reader-side { align-self: start; position: sticky; top: 112px; padding: 18px; border-radius: 18px; color: #fff; background: rgba(52,54,94,.85); box-shadow: 0 10px 26px rgba(52,54,94,.2); }
.back-link { display: block; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,.18); font-weight: 800; }
.chapter-marker { margin: 19px 0; padding: 14px; background: $pink; color: #fff; clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%); }
.chapter-marker span { display: block; font-size: 10px; letter-spacing: .15em; }
.chapter-marker strong { font-size: 30px; }
.reader-meta { display: grid; gap: 4px; }
.reader-meta span { margin-top: 10px; font-size: 10px; opacity: .65; }
.tag-stack { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 20px; }
.tag-stack a { padding: 5px 8px; border: 1px solid rgba(255,255,255,.25); border-radius: 12px; font-size: 11px; }
.reader-card { position: relative; padding: clamp(28px, 5vw, 68px); border-radius: 28px; background: rgba(250,250,253,.96); box-shadow: 0 22px 60px rgba(52,54,94,.26); overflow: hidden; }
.reader-card:before { content: ""; position: absolute; inset: 0 0 auto 0; height: 8px; background: var(--accent); }
.article-head { padding-bottom: 28px; border-bottom: 1px solid #d9d9e4; }
.article-head p { margin: 0 0 10px; color: var(--accent); font-size: 12px; font-weight: 900; letter-spacing: .12em; }
.article-head h1 { margin: 0; color: $deep; font-size: clamp(34px, 5vw, 54px); line-height: 1.18; letter-spacing: -.04em; }
.article-lead { margin-top: 18px; color: #73748c; line-height: 1.75; }
.article-content { color: #4b4c62; font-size: 16px; line-height: 1.95; }
.article-content h2 { margin: 44px 0 12px; color: $deep; font-size: 26px; }
.article-content h2:before { content: "◇"; margin-right: 9px; color: var(--accent); }
.article-content a { color: #168e88; border-bottom: 1px solid currentColor; }
.article-content code { padding: 2px 6px; border-radius: 5px; background: #e9e9f2; }
.article-content pre { overflow: auto; padding: 20px; border-radius: 12px; background: $deep; color: #f4f4fa; }
.article-content pre code { padding: 0; background: transparent; }
.article-content img { max-width: 100%; border-radius: 12px; }
.post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; padding-top: 24px; border-top: 1px solid #d9d9e4; }
.post-nav a { display: grid; padding: 14px; border-radius: 12px; background: #eeeef5; }
.post-nav .next { text-align: right; }
.post-nav small { font-size: 9px; font-weight: 900; color: #898aa0; }
.post-nav span { margin-top: 3px; font-weight: 800; }

.panel-page, .profile-page { width: calc(100% - 40px); max-width: 1000px; margin: 0 auto; padding: 132px 0 70px; }
.panel-page { min-height: 100vh; }
.panel-page__head { margin-bottom: 24px; color: #fff; text-shadow: 0 3px 11px rgba(52,54,94,.3); }
.panel-page__head p { margin: 0; font-size: 11px; font-weight: 900; letter-spacing: .18em; }
.panel-page__head h1 { margin: 4px 0; font-size: 52px; line-height: 1; }
.panel-page__head span { font-size: 13px; }
.timeline, .collection-grid, .tag-cloud, .search-box, .search-results { padding: 20px; border-radius: 22px; background: rgba(55,56,96,.84); box-shadow: 0 18px 45px rgba(52,54,94,.22); }
.timeline__year { padding: 12px 12px 7px; color: $cyan; font-size: 28px; font-weight: 900; }
.timeline__item { display: grid; grid-template-columns: 70px 1fr 25px; align-items: center; gap: 12px; margin: 8px 0; padding: 16px; border-radius: 12px; background: rgba(249,249,252,.94); box-shadow: 0 4px 0 rgba(26,27,52,.45); }
.timeline__item time { color: $pink; font-weight: 900; }
.timeline__item span { display: grid; }
.timeline__item small { font-size: 10px; opacity: .6; }
.timeline__item b { font-size: 17px; }
.timeline__item i { font-size: 30px; font-style: normal; }
.collection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
.collection-card { display: grid; grid-template-columns: 52px 1fr 30px; align-items: center; gap: 15px; min-height: 128px; padding: 18px; border-radius: 15px; background: rgba(249,249,252,.95); box-shadow: 0 5px 0 rgba(26,27,52,.45); }
.collection-card > span { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; background: var(--accent); font-weight: 900; }
.collection-card div { display: grid; }
.collection-card small { font-size: 9px; letter-spacing: .15em; opacity: .55; }
.collection-card strong { font-size: 23px; }
.collection-card em { font-style: normal; font-size: 11px; opacity: .62; }
.collection-card i { font-size: 34px; font-style: normal; }
.tag-cloud { display: flex; flex-wrap: wrap; gap: 11px; }
.tag-cloud a { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 14px; background: #f8f8fc; font-weight: 800; box-shadow: 0 4px 0 rgba(26,27,52,.45); }
.tag-cloud a > span { color: $pink; }
.tag-cloud small { display: grid; place-items: center; min-width: 22px; height: 22px; border-radius: 50%; background: $cyan; font-size: 9px; }
.profile-page { min-height: 100vh; display: grid; place-items: center; }
.profile-card { width: 100%; display: grid; grid-template-columns: 220px 1fr; gap: 30px; padding: 38px; border: 14px solid rgba(55,56,96,.92); border-radius: 36px; background: rgba(249,249,252,.95); box-shadow: 0 24px 60px rgba(52,54,94,.3); }
.profile-avatar { position: relative; display: grid; place-items: center; min-height: 250px; border-radius: 20px; background: linear-gradient(145deg, $cyan, #a9e7ea 45%, #d6c7ea); overflow: hidden; }
.profile-avatar:after { content: ""; position: absolute; width: 170px; height: 170px; bottom: -75px; border-radius: 50%; background: $deep; opacity: .75; }
.profile-avatar span { font-size: 86px; font-weight: 200; color: #fff; text-shadow: 0 5px 20px rgba(52,54,94,.25); }
.profile-avatar i { position: absolute; right: 15px; top: 15px; width: 14px; height: 14px; border-radius: 50%; background: $pink; box-shadow: 0 0 0 6px rgba(255,255,255,.7); }
.profile-copy p { margin: 5px 0; color: $pink; font-size: 11px; font-weight: 900; letter-spacing: .15em; }
.profile-copy h1 { margin: 0; color: $deep; font-size: 48px; }
.profile-copy > strong { color: #85869c; }
.profile-message { margin-top: 22px; line-height: 1.8; }
.profile-stats { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-top: 20px; border-top: 1px solid #d9d9e4; }
.profile-stats span { display: grid; padding: 12px; border-radius: 10px; background: #ececf3; }
.profile-stats small { font-size: 9px; color: #898aa0; }
.profile-stats b { font-size: 20px; }
.profile-stats .online { color: #139d91; }
.search-box { display: grid; grid-template-columns: 1fr auto; padding: 14px; border-radius: 18px; }
.search-box input { min-width: 0; padding: 14px 18px; border: 0; border-radius: 12px 0 0 12px; outline: 0; }
.search-box input:focus { box-shadow: inset 0 0 0 3px $cyan; }
.search-box button { padding: 0 25px; border: 0; border-radius: 0 12px 12px 0; color: $deep; background: $cyan; font-weight: 900; cursor: pointer; }
.search-state { color: #fff; font-size: 13px; font-weight: 800; }
.search-results { display: grid; gap: 10px; padding: 0; background: transparent; box-shadow: none; }
.search-results a { display: grid; grid-template-columns: 48px 1fr 28px; align-items: center; gap: 13px; padding: 17px; border-radius: 13px; background: rgba(249,249,252,.95); box-shadow: 0 4px 0 rgba(26,27,52,.4); }
.search-results > a > b { display: grid; place-items: center; width: 45px; height: 45px; border-radius: 50%; background: $pink; }
.search-results span { display: grid; min-width: 0; }
.search-results small { font-size: 9px; opacity: .56; }
.search-results strong { font-size: 18px; }
.search-results em { overflow: hidden; font-size: 11px; font-style: normal; opacity: .65; white-space: nowrap; text-overflow: ellipsis; }
.search-results i { font-size: 30px; font-style: normal; }

@media (max-width: 900px) {
  .home-shell { display: block; padding: 110px 20px 35px; overflow: visible; }
  .home-intro { margin-bottom: 34px; }
  .home-intro h1 { font-size: 76px; }
  .device-wrap { transform: none; }
  .device { padding: 9px; border-width: 3px; border-radius: 32px; }
  .device__speaker { display: none; }
  .device__screen { min-height: auto; padding: 25px 15px; border-radius: 23px; }
  .reader-shell { display: block; padding-top: 110px; }
  .reader-side { position: static; margin-bottom: 14px; }
  .reader-meta, .tag-stack, .chapter-marker { display: none; }
  .profile-card { grid-template-columns: 150px 1fr; }
}

@media (max-width: 600px) {
  .topbar { height: 74px; padding: 12px 14px; }
  .site-chip > span:last-child, .status-chip { display: none; }
  .menu-panel nav { grid-template-columns: 1fr; }
  .menu-panel nav a { min-height: 76px; }
  .home-shell { padding-left: 12px; padding-right: 12px; }
  .record-card { grid-template-columns: 43px 1fr 22px; min-height: 105px; padding: 10px; }
  .record-card__index { width: 38px; height: 38px; }
  .record-card__body strong { font-size: 15px; }
  .quick-grid { grid-template-columns: 1fr; }
  .quick-grid a { min-height: 58px; }
  .reader-shell, .panel-page, .profile-page { width: calc(100% - 20px); }
  .reader-card { padding: 30px 21px; border-radius: 20px; }
  .article-head h1 { font-size: 34px; }
  .post-nav { grid-template-columns: 1fr; }
  .collection-grid { grid-template-columns: 1fr; padding: 12px; }
  .panel-page__head h1 { font-size: 40px; }
  .timeline { padding: 12px; }
  .timeline__item { grid-template-columns: 54px 1fr 16px; padding: 13px 10px; }
  .profile-card { grid-template-columns: 1fr; padding: 18px; border-width: 8px; }
  .profile-avatar { min-height: 180px; }
  .profile-copy h1 { font-size: 38px; }
  .profile-stats { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  *, *:before, *:after { scroll-behavior: auto !important; transition: none !important; }
}
