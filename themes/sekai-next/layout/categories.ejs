<section class="panel-page">
  <header class="panel-page__head"><p>SELECT A SEKAI</p><h1>文章分类</h1><span>从不同主题进入记录</span></header>
  <div class="collection-grid">
    <% ['CTF', 'Android', '漏洞挖掘', '逆向工程', 'AI', '其他'].forEach(function(name, index) {
      const category = site.categories.findOne({name: name}) || {name: name, length: 0, path: '/search/?category=' + encodeURIComponent(name)}; %>
      <a class="collection-card" style="--accent:<%= ['#33ccbb','#4455dd','#88dd44','#ee1166','#ff9900','#884499'][index] %>" href="<%- url_for(category.path) %>">
        <img class="category-unit-icon" src="<%- url_for('/game-assets/icon_tab_unit_' + ['vs','ln','mj','vb','ws','25'][index] + '_on.png') %>" alt=""><div><small>CATEGORY</small><strong><%= category.name %></strong><em><%= category.length %> 条记录</em></div><i>›</i>
      </a>
    <% }) %>
  </div>
</section>
