<article class="reader-shell" data-post-path="<%= page.path %>">
  <aside class="reader-side">
    <a class="back-link" href="<%- url_for('/search/') %>">← 返回文章选择</a>
    <div class="chapter-marker"><span>CHAPTER</span><strong><%= date(page.date, 'MM.DD') %></strong></div>
    <div class="reader-meta">
      <span>发布日期</span><b><%= date(page.date, 'YYYY.MM.DD') %></b>
      <span>所属分类</span><b><%= page.categories.length ? page.categories.first().name : '未分类' %></b>
    </div>
    <% if (page.tags.length) { %>
      <div class="tag-stack"><% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }) %></div>
    <% } %>
  </aside>

  <% const categoryPalette = {'CTF':'#33ccbb','Android':'#4455dd','漏洞挖掘':'#88dd44','逆向工程':'#ee1166','AI':'#ff9900','其他':'#884499'};
     const postCategories = page.categories.map(c => c.name.toLowerCase());
     const primaryCategory = Object.keys(categoryPalette).find(c => postCategories.includes(c.toLowerCase())) || '其他'; %>
  <div class="reader-card" style="--accent:<%= categoryPalette[primaryCategory] %>" tabindex="0" aria-label="文章阅读区">
    <header class="article-head" id="article-start">
      <p><%= page.categories.length ? page.categories.first().name : 'PERSONAL RECORD' %></p>
      <small class="reading-count">阅读 <span data-post-views="<%= page.path %>">0</span> · 本机演示计数</small>
      <h1><%= page.title %></h1>
      <% if (page.excerpt) { %><div class="article-lead"><%= strip_html(page.excerpt) %></div><% } %>
    </header>
    <div class="article-content"><%- page.content %></div>
    <nav class="post-nav">
      <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>"><small>← PREVIOUS</small><span><%= page.prev.title %></span></a><% } else { %><span></span><% } %>
      <% if (page.next) { %><a class="next" href="<%- url_for(page.next.path) %>"><small>NEXT →</small><span><%= page.next.title %></span></a><% } %>
    </nav>
  </div>
  <aside class="reader-side reader-toc-side">
    <details class="chapter-index" open>
      <summary>章节目录</summary>
      <nav aria-label="文章章节"><%- toc(page.content, {class: 'chapter-toc', list_number: true, max_depth: 4}) || '<a href="#article-start">正文</a>' %></nav>
    </details>
  </aside>
</article>
<script src="<%- url_for('/js/reader.js') %>" defer></script>
